<?xml version="1.0" encoding="UTF-8"?>

<!-- The top of the Cadran Play timer (tab/cadran_play_timer_tab.cpp, over
     the tab's own lines): the week's summary with the profile and "same limit
     every day" chips, the week as the editor (the time played in its bars)
     with its keys, the changes not saved yet, then bedtime, time's up and
     removal as chips. -->

<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch">

    <brls:Box axis="row" alignItems="flexEnd" marginBottom="14">
        <brls:Box axis="column" alignItems="flexStart" grow="1.0" width="0" marginRight="12">
            <brls:Label id="cpt_kicker" text="" fontSize="15" textColor="@theme/cadran/text3" marginBottom="6"/>
            <CadranDigits id="cpt_summary" text="—" fontSize="28" fitWidth="520"/>
        </brls:Box>
        <brls:Box id="cpt_profile" focusable="true" hideHighlightBackground="true" highlightCornerRadius="23" shrink="0" axis="row" alignItems="center" height="46" paddingLeft="18" paddingRight="18" cornerRadius="23" backgroundColor="@theme/cadran/surf2" borderColor="@theme/cadran/line" borderThickness="1" marginRight="10">
            <CadranIcon icon="list" width="18" height="18" marginRight="10"/>
            <brls:Label id="cpt_profile_name" text="" fontSize="15" singleLine="true"/>
        </brls:Box>
        <brls:Box id="cpt_uniform" focusable="true" hideHighlightBackground="true" highlightCornerRadius="23" shrink="0" axis="row" alignItems="center" height="46" paddingLeft="18" paddingRight="18" cornerRadius="23" backgroundColor="@theme/cadran/surf2" borderColor="@theme/cadran/line" borderThickness="1">
            <brls:Label text="@i18n/playguard/play_timer/quick" fontSize="15" singleLine="true"/>
        </brls:Box>
    </brls:Box>

    <brls:Box axis="column" alignItems="stretch" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="24" paddingTop="16" paddingBottom="14" paddingLeft="22" paddingRight="22" marginBottom="10">
        <CadranWeekView id="cpt_week" width="auto" height="262" marginBottom="8"/>
        <brls:Box id="cpt_keys_idle" axis="row" alignItems="center" paddingTop="8" lineColor="@theme/cadran/line" lineTop="1px">
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="26" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranDigits text="A" fontSize="13" textColor="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/edit_day" fontSize="15" textColor="@theme/cadran/text2" marginRight="18"/>
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="26" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranDigits text="X" fontSize="13" textColor="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/pick_day" fontSize="15" textColor="@theme/cadran/text2"/>
            <brls:Box grow="1.0"/>
            <brls:Box id="cpt_played_key" axis="row" alignItems="center" visibility="gone">
                <brls:Rectangle width="12" height="12" cornerRadius="3" color="@theme/cadran/teal_fill" marginRight="8"/>
                <brls:Label text="@i18n/playguard/cadran/week/played_key" fontSize="15" textColor="@theme/cadran/text2" singleLine="true"/>
            </brls:Box>
        </brls:Box>
        <brls:Box id="cpt_keys_edit" axis="row" alignItems="center" paddingTop="8" lineColor="@theme/cadran/line" lineTop="1px" visibility="gone">
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="36" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranIcon icon="caret-up" width="12" height="12" color="@theme/cadran/key_fg"/>
                <CadranIcon icon="caret-down" width="12" height="12" color="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/step" fontSize="15" textColor="@theme/cadran/text2" marginRight="16"/>
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="36" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranIcon icon="chevron-left" width="12" height="12" color="@theme/cadran/key_fg"/>
                <CadranIcon icon="chevron-right" width="12" height="12" color="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/day" fontSize="15" textColor="@theme/cadran/text2" marginRight="16"/>
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="26" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranDigits text="L" fontSize="13" textColor="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/weekdays" fontSize="15" textColor="@theme/cadran/text2" marginRight="16"/>
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="26" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranDigits text="R" fontSize="13" textColor="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/weekend" fontSize="15" textColor="@theme/cadran/text2" marginRight="16"/>
            <brls:Box axis="row" alignItems="center" justifyContent="center" width="26" height="26" cornerRadius="13" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                <CadranDigits text="Y" fontSize="13" textColor="@theme/cadran/key_fg"/>
            </brls:Box>
            <brls:Label text="@i18n/playguard/cadran/week/none" fontSize="15" textColor="@theme/cadran/text2"/>
        </brls:Box>
    </brls:Box>

    <brls:Box axis="row" alignItems="center" marginBottom="12" height="44">
        <brls:Rectangle id="cpt_pending_dot" width="9" height="9" cornerRadius="4.5" color="@theme/cadran/amber_fill" marginRight="8"/>
        <brls:Label id="cpt_pending" text="" fontSize="15" textColor="@theme/cadran/text3" grow="1.0" width="0" singleLine="true"/>
        <brls:Button id="cpt_discard" style="bordered" text="@i18n/playguard/cadran/week/discard" fontSize="15" height="40" cornerRadius="20" highlightCornerRadius="20" paddingLeft="18" paddingRight="18" textColor="@theme/cadran/text2" borderColor="@theme/cadran/line" borderThickness="2" marginRight="10"/>
        <brls:Button id="cpt_save" style="primary" text="@i18n/playguard/play_timer/perday/section_save" fontSize="15" height="40" cornerRadius="20" highlightCornerRadius="22" paddingLeft="20" paddingRight="20"/>
    </brls:Box>

    <brls:Box id="cpt_chips" axis="row" alignItems="center" marginBottom="8">
        <brls:Box id="cpt_bed" focusable="true" hideHighlightBackground="true" highlightCornerRadius="23" shrink="0" axis="row" alignItems="center" height="46" paddingLeft="18" paddingRight="18" cornerRadius="23" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" marginRight="10" marginBottom="8">
            <CadranIcon icon="moon" width="18" height="18" marginRight="10"/>
            <brls:Label text="@i18n/playguard/play_timer/section_bedtime" fontSize="15" marginRight="8" singleLine="true"/>
            <CadranDigits id="cpt_bed_value" text="—" fontSize="15" textColor="@theme/cadran/teal"/>
            <CadranIcon id="cpt_bed_arrow" icon="chevron-right" width="14" height="14" color="@theme/cadran/teal" marginLeft="4" marginRight="4"/>
            <CadranDigits id="cpt_bed_end" text="" fontSize="15" textColor="@theme/cadran/teal"/>
        </brls:Box>
        <brls:Box id="cpt_time_up" focusable="true" hideHighlightBackground="true" highlightCornerRadius="23" shrink="0" axis="row" alignItems="center" height="46" paddingLeft="18" paddingRight="18" cornerRadius="23" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" marginRight="10" marginBottom="8">
            <CadranIcon icon="bell" width="18" height="18" marginRight="10"/>
            <brls:Label text="@i18n/playguard/play_timer/time_up" fontSize="15" marginRight="8" singleLine="true"/>
            <brls:Label id="cpt_time_up_value" text="" fontSize="15" textColor="@theme/cadran/teal" singleLine="true"/>
        </brls:Box>
        <brls:Box id="cpt_remove" focusable="true" hideHighlightBackground="true" highlightCornerRadius="23" shrink="0" axis="row" alignItems="center" height="46" paddingLeft="18" paddingRight="18" cornerRadius="23" borderColor="@theme/cadran/coral_line" borderThickness="2" marginBottom="8">
            <CadranIcon icon="trash" width="18" height="18" marginRight="10" color="@theme/cadran/coral"/>
            <brls:Label text="@i18n/playguard/cadran/week/remove" fontSize="15" textColor="@theme/cadran/coral" singleLine="true"/>
        </brls:Box>
    </brls:Box>

</brls:Box>
