<?xml version="1.0" encoding="UTF-8"?>

<!-- The top of the Cadran Overview (tab/cadran_tab.cpp, over the Overview's
     own lines): today's time left as a ring with the everyday actions beside
     it, three state cards, the console's state as pills. Filled by
     CadranTab::refresh() from the Overview's readings. -->

<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch">

    <brls:Box axis="row" alignItems="center" marginBottom="18">
        <PtRing id="cad_ring" width="248" height="248" marginRight="36"/>
        <brls:Box id="cad_today_text" axis="column" alignItems="flexStart" grow="1.0" width="0">
            <brls:Label id="cad_kicker" text="" fontSize="14" textColor="@theme/cadran/text3" marginBottom="10"/>
            <brls:Box id="cad_actions" axis="row" alignItems="center" marginTop="14" marginBottom="12">
                <brls:Button id="cad_extra" style="primary" text="@i18n/playguard/cadran/today/extra" fontSize="19" height="56" cornerRadius="28" paddingLeft="22" paddingRight="22" marginRight="12"/>
                <brls:Box id="cad_chips" axis="row" alignItems="center"/>
            </brls:Box>
            <brls:Box axis="row" alignItems="center">
                <brls:Button id="cad_stop" style="bordered" text="@i18n/playguard/cadran/today/stop" fontSize="17" height="48" cornerRadius="24" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/coral" borderColor="@theme/cadran/coral_line" borderThickness="2" marginRight="12"/>
                <brls:Button id="cad_child" style="bordered" text="@i18n/playguard/cadran/today/child" fontSize="17" height="48" cornerRadius="24" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/text2" borderColor="@theme/cadran/line" borderThickness="2"/>
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box axis="row" alignItems="stretch" marginBottom="14">
        <brls:Box id="cad_bed_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="20" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="20" paddingBottom="20" paddingLeft="24" paddingRight="24" marginRight="16">
            <brls:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                <brls:Label text="@i18n/playguard/cadran/today/bed_title" fontSize="15" textColor="@theme/cadran/text3"/>
                <brls:Label id="cad_bed_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
            </brls:Box>
            <CadranDigits id="cad_bed_value" text="—" fontSize="32" marginTop="6" marginBottom="6"/>
            <brls:Label id="cad_bed_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
        </brls:Box>
        <brls:Box id="cad_pc_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="20" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="20" paddingBottom="20" paddingLeft="24" paddingRight="24" marginRight="16">
            <brls:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                <brls:Label text="@i18n/playguard/cadran/today/pc_title" fontSize="15" textColor="@theme/cadran/text3"/>
                <brls:Label id="cad_pc_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
            </brls:Box>
            <CadranDigits id="cad_pc_value" text="—" fontSize="32" marginTop="6" marginBottom="6" fitWidth="250"/>
            <brls:Label id="cad_pc_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
        </brls:Box>
        <brls:Box id="cad_clock_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="20" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="20" paddingBottom="20" paddingLeft="24" paddingRight="24">
            <brls:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                <brls:Label id="cad_clock_title" text="@i18n/playguard/cadran/today/clock_title" fontSize="15" textColor="@theme/cadran/text3"/>
                <brls:Label id="cad_clock_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
            </brls:Box>
            <CadranDigits id="cad_clock_value" text="—" fontSize="32" marginTop="6" marginBottom="6" fitWidth="250"/>
            <brls:Box axis="row" alignItems="center">
                <brls:Box id="cad_clock_key" axis="row" alignItems="center" justifyContent="center" width="22" height="22" cornerRadius="11" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                    <CadranDigits text="A" fontSize="12" textColor="@theme/cadran/key_fg"/>
                </brls:Box>
                <brls:Label id="cad_clock_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box id="cad_pills" axis="row" alignItems="center" marginBottom="6"/>

</brls:Box>
