<?xml version="1.0" encoding="UTF-8"?>

<!-- PtStateHeader: only when the day's limit is reached, a warning line;
     another while the console is not counting play time. Filled by
     source/view/pt_state_header.cpp. -->

<aurore:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch"
    marginBottom="16">

    <aurore:Label id="pt_alert" text="" fontSize="20" marginTop="6" textColor="@theme/cadran/coral"/>
    <aurore:Label id="pt_health" text="@i18n/playguard/play_timer/not_counting" fontSize="20" marginTop="6" textColor="@theme/cadran/amber"/>

</aurore:Box>
