<?xml version="1.0" encoding="UTF-8"?>

<!-- The top of the Cadran Activity (tab/cadran_activity_tab.cpp, over the
     tab's own lines): the accounts as chips, the period and the export, three
     figures, the games of the period as cards. -->

<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch">

    <brls:Box axis="row" alignItems="center" marginBottom="14">
        <brls:Box id="cac_accounts" axis="row" alignItems="center" grow="1.0" width="0"/>
        <brls:Box id="cac_period" focusable="true" hideHighlightBackground="true" highlightCornerRadius="22" shrink="0" axis="row" alignItems="center" height="44" paddingLeft="18" paddingRight="18" cornerRadius="22" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" marginRight="10">
            <brls:Label id="cac_period_label" text="" fontSize="16" marginRight="8" singleLine="true"/>
            <CadranIcon icon="chevron-down" width="16" height="16"/>
        </brls:Box>
        <brls:Box id="cac_export" focusable="true" hideHighlightBackground="true" highlightCornerRadius="22" shrink="0" axis="row" alignItems="center" height="44" paddingLeft="18" paddingRight="18" cornerRadius="22" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1">
            <CadranIcon icon="download" width="18" height="18" marginRight="10"/>
            <brls:Label text="@i18n/playguard/cadran/activity/export" fontSize="16" singleLine="true"/>
        </brls:Box>
    </brls:Box>

    <brls:Box axis="row" alignItems="stretch" marginBottom="14">
        <brls:Box axis="column" alignItems="flexStart" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="18" paddingBottom="18" paddingLeft="24" paddingRight="24" marginRight="14">
            <brls:Label text="@i18n/playguard/activity/today" fontSize="15" textColor="@theme/cadran/text3" singleLine="true"/>
            <CadranDigits id="cac_today" text="—" fontSize="36" marginTop="6" marginBottom="6"/>
            <brls:Label id="cac_today_sub" text="" fontSize="15" textColor="@theme/cadran/text2" alignSelf="stretch"/>
        </brls:Box>
        <brls:Box axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="18" paddingBottom="18" paddingLeft="24" paddingRight="24" marginRight="14">
            <brls:Box axis="row" alignItems="flexEnd">
                <brls:Box axis="column" alignItems="flexStart" grow="1.0" width="0">
                    <brls:Label text="@i18n/playguard/activity/week" fontSize="15" textColor="@theme/cadran/text3" singleLine="true"/>
                    <CadranDigits id="cac_week" text="—" fontSize="36" marginTop="6" marginBottom="6"/>
                    <brls:Label id="cac_week_sub" text="" fontSize="15" textColor="@theme/cadran/text2" alignSelf="stretch"/>
                </brls:Box>
                <brls:Box id="cac_week_bars" axis="row" alignItems="flexEnd" height="56" marginLeft="10" shrink="0">
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3" marginRight="3"/>
                    <brls:Box width="8" height="3" cornerRadius="3"/>
                </brls:Box>
            </brls:Box>
            <!-- Against the 7 days before, the tile's whole width. -->
            <brls:Label id="cac_week_trend" text="" fontSize="15" textColor="@theme/cadran/text3" marginTop="6" visibility="gone"/>
        </brls:Box>
        <brls:Box axis="column" alignItems="flexStart" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="20" paddingTop="18" paddingBottom="18" paddingLeft="24" paddingRight="24">
            <brls:Label text="@i18n/playguard/activity/all_time" fontSize="15" textColor="@theme/cadran/text3" singleLine="true"/>
            <CadranDigits id="cac_total" text="—" fontSize="36" marginTop="6" marginBottom="6"/>
            <brls:Label id="cac_total_sub" text="" fontSize="15" textColor="@theme/cadran/text2" alignSelf="stretch"/>
        </brls:Box>
    </brls:Box>

    <brls:Label id="cac_games_title" text="" fontSize="15" textColor="@theme/cadran/text3" marginBottom="10"/>
    <brls:Label id="cac_games_note" text="" fontSize="16" textColor="@theme/cadran/text2" marginBottom="6"/>
    <brls:Box id="cac_games" axis="column" alignItems="stretch"/>

</brls:Box>
