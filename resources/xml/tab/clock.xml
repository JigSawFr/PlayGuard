<?xml version="1.0" encoding="UTF-8"?>

<!-- Network clock: read clocks, pick an NTP server, measure, apply. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header title="@i18n/playguard/clock/section_now" marginBottom="8"/>
            <aurore:DetailCell id="ck_auto" title="@i18n/playguard/clock/auto"/>
            <aurore:DetailCell id="ck_zone" focusable="false" title="@i18n/playguard/clock/zone"/>
            <aurore:Label id="ck_why" text="@i18n/playguard/clock/why" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Header title="@i18n/playguard/clock/section_server" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="ck_region" title="@i18n/playguard/clock/region"/>
            <aurore:DetailCell id="ck_server" title="@i18n/playguard/clock/server"/>
            <aurore:DetailCell id="ck_custom" title="@i18n/playguard/clock/custom"/>
            <aurore:Header title="@i18n/playguard/clock/section_sync" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="ck_measure" title="@i18n/playguard/clock/measure"/>
            <aurore:Box id="ck_result_card" axis="column" alignItems="stretch" marginTop="8" marginBottom="8" marginLeft="10" marginRight="10" cornerRadius="@style/cadran/radius/card">
                <aurore:Label id="ck_result_title" text="" fontSize="18" textColor="@theme/cadran/amber" marginBottom="8" visibility="gone"/>
                <aurore:Label id="ck_result" text="" fontSize="16.5"/>
            </aurore:Box>
            <aurore:Label id="ck_warning" text="" fontSize="20" marginBottom="8" marginLeft="16" marginRight="16" textColor="@theme/cadran/amber"/>
            <aurore:DetailCell id="ck_apply" title="@i18n/playguard/clock/apply"/>
            <aurore:DetailCell id="ck_copy" title="@i18n/playguard/clock/copy"/>
            <aurore:BooleanCell id="ck_check_at_start" marginTop="24"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
