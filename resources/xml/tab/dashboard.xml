<?xml version="1.0" encoding="UTF-8"?>

<!-- Today: today's time left as a ring with the everyday actions beside it
     (turning parental controls back on first, the row's whole width, while
     they are unlocked, or setting the week's limits while there are none;
     today's limit and the profile in force with them, the second row's
     buttons sharing its width), three state cards, the console's state as
     pills (dash_top). Above it, in applet mode, why PlayGuard opened over a
     game counts; tab/dashboard_tab.cpp adds the first steps and the changes
     seen outside PlayGuard under that. Under it, the extra time to put back
     and the alarm turned off. Refreshed every few seconds. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Label id="dash_applet" text="@i18n/playguard/dashboard/applet" fontSize="20" marginBottom="12" textColor="@theme/cadran/amber"/>
            <aurore:Box id="dash_top" axis="column" alignItems="stretch">
                <aurore:Box axis="row" alignItems="center" marginBottom="30">
                    <PtRing id="dash_ring" width="248" height="248" marginRight="36"/>
                    <aurore:Box id="dash_today_text" axis="column" alignItems="flexStart" grow="1.0" width="0">
                        <aurore:Label id="dash_kicker" text="" fontSize="16" textColor="@theme/cadran/text2" marginBottom="12"/>
                        <aurore:Label id="dash_gauge_text" text="" fontSize="30" textColor="@theme/cadran/text"/>
                        <aurore:Label id="dash_not_counting" text="@i18n/playguard/play_timer/not_counting" fontSize="16.5" marginTop="6" textColor="@theme/cadran/amber"/>
                        <aurore:Box id="dash_actions" axis="row" alignItems="center" alignSelf="stretch" marginTop="20" marginBottom="18">
                            <aurore:Button id="dash_relock" style="primary" text="@i18n/playguard/security/banner_action" fontSize="19" height="56" cornerRadius="28" highlightCornerRadius="30" paddingLeft="22" paddingRight="22" grow="1.0" visibility="gone"/>
                            <aurore:Button id="dash_setup" style="primary" text="@i18n/playguard/cadran/today/setup" fontSize="19" height="56" cornerRadius="28" highlightCornerRadius="30" paddingLeft="22" paddingRight="22" grow="1.0" visibility="gone"/>
                            <aurore:Box id="dash_chips" axis="row" alignItems="center"/>
                        </aurore:Box>
                        <aurore:Box id="dash_actions2" axis="row" alignItems="center" alignSelf="stretch">
                            <aurore:Button id="dash_stop" style="bordered" text="@i18n/playguard/cadran/today/stop" fontSize="17" height="48" cornerRadius="24" highlightCornerRadius="24" grow="1.0" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/coral" borderColor="@theme/cadran/coral_line" borderThickness="2"/>
                            <aurore:Button id="dash_child" style="bordered" text="@i18n/playguard/cadran/today/child" fontSize="17" height="48" cornerRadius="24" highlightCornerRadius="24" grow="1.0" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/text2" borderColor="@theme/cadran/line" borderThickness="2"/>
                            <aurore:Button id="dash_limit" style="bordered" text="@i18n/playguard/cadran/today/limit" fontSize="17" height="48" cornerRadius="24" highlightCornerRadius="24" grow="1.0" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/text2" borderColor="@theme/cadran/line" borderThickness="2"/>
                            <aurore:Button id="dash_profile" style="bordered" text="" fontSize="17" height="48" cornerRadius="24" highlightCornerRadius="24" grow="1.0" paddingLeft="20" paddingRight="20" textColor="@theme/cadran/text2" borderColor="@theme/cadran/line" borderThickness="2" visibility="gone"/>
                        </aurore:Box>
                    </aurore:Box>
                </aurore:Box>

                <aurore:Box axis="row" alignItems="stretch" marginBottom="24">
                    <aurore:Box id="dash_bed_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="@style/cadran/radius/card" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="@style/cadran/radius/card" paddingTop="24" paddingBottom="24" paddingLeft="24" paddingRight="24" marginRight="16">
                        <aurore:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                            <aurore:Label text="@i18n/playguard/cadran/today/bed_title" fontSize="16" textColor="@theme/cadran/text2"/>
                            <aurore:Label id="dash_bed_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
                        </aurore:Box>
                        <CadranDigits id="dash_bed_value" text="—" fontSize="32" marginTop="8" marginBottom="8" fitWidth="250"/>
                        <aurore:Box axis="row" alignItems="center">
                            <aurore:Box id="dash_bed_key" axis="row" alignItems="center" justifyContent="center" width="22" height="22" cornerRadius="11" backgroundColor="@theme/cadran/key_bg" marginRight="8" visibility="gone">
                                <CadranDigits text="A" fontSize="12" textColor="@theme/cadran/key_fg"/>
                            </aurore:Box>
                            <aurore:Label id="dash_bed_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
                        </aurore:Box>
                    </aurore:Box>
                    <aurore:Box id="dash_pc_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="@style/cadran/radius/card" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="@style/cadran/radius/card" paddingTop="24" paddingBottom="24" paddingLeft="24" paddingRight="24" marginRight="16">
                        <aurore:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                            <aurore:Label text="@i18n/playguard/cadran/today/pc_title" fontSize="16" textColor="@theme/cadran/text2"/>
                            <aurore:Label id="dash_pc_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
                        </aurore:Box>
                        <CadranDigits id="dash_pc_value" text="—" fontSize="32" marginTop="8" marginBottom="8" fitWidth="250"/>
                        <aurore:Label id="dash_pc_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
                    </aurore:Box>
                    <aurore:Box id="dash_clock_card" focusable="true" hideHighlightBackground="true" highlightCornerRadius="@style/cadran/radius/card" axis="column" alignItems="stretch" grow="1.0" width="0" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" cornerRadius="@style/cadran/radius/card" paddingTop="24" paddingBottom="24" paddingLeft="24" paddingRight="24">
                        <aurore:Box axis="row" justifyContent="spaceBetween" alignItems="center">
                            <aurore:Label id="dash_clock_title" text="@i18n/playguard/cadran/today/clock_title" fontSize="16" textColor="@theme/cadran/text2"/>
                            <aurore:Label id="dash_clock_state" text="" fontSize="15" textColor="@theme/cadran/teal"/>
                        </aurore:Box>
                        <CadranDigits id="dash_clock_value" text="—" fontSize="32" marginTop="8" marginBottom="8" fitWidth="250"/>
                        <aurore:Box axis="row" alignItems="center">
                            <aurore:Box id="dash_clock_key" axis="row" alignItems="center" justifyContent="center" width="22" height="22" cornerRadius="11" backgroundColor="@theme/cadran/key_bg" marginRight="8">
                                <CadranDigits text="A" fontSize="12" textColor="@theme/cadran/key_fg"/>
                            </aurore:Box>
                            <aurore:Label id="dash_clock_sub" text="" fontSize="15" textColor="@theme/cadran/text2"/>
                        </aurore:Box>
                    </aurore:Box>
                </aurore:Box>

                <aurore:Box id="dash_pills" axis="row" alignItems="center" marginBottom="6"/>
            </aurore:Box>
            <aurore:DetailCell id="dash_extra_pending"/>
            <aurore:DetailCell id="dash_alarm" title="@i18n/playguard/play_timer/alarm"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
