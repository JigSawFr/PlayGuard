<?xml version="1.0" encoding="UTF-8"?>

<!-- Preferences: PlayGuard itself (language, theme, start tab), what it
     does at start-up, its notifications and its updates. A setting that
     shapes one feature sits with it (extra time in Play timer, relocking
     in PIN, the clock check in Network clock). -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header title="@i18n/playguard/prefs/section_app" marginBottom="8"/>
            <brls:DetailCell id="pf_language" title="@i18n/playguard/tools/language"/>
            <brls:DetailCell id="pf_theme" title="@i18n/playguard/tools/theme"/>
            <brls:DetailCell id="pf_start_tab" title="@i18n/playguard/tools/start_tab"/>
            <brls:Header title="@i18n/playguard/prefs/section_startup" marginTop="24" marginBottom="8"/>
            <brls:BooleanCell id="pf_intro"/>
            <brls:BooleanCell id="pf_support_reminder"/>
            <brls:Header title="@i18n/playguard/prefs/section_notices" marginTop="24" marginBottom="8"/>
            <brls:BooleanCell id="pf_notices_system"/>
            <brls:BooleanCell id="pf_notices_summary"/>
            <brls:BooleanCell id="pf_notices_reminders"/>
            <brls:Header title="@i18n/playguard/tools/section_update" marginTop="24" marginBottom="8"/>
            <brls:BooleanCell id="pf_update_daily"/>
            <brls:DetailCell id="pf_update_via" title="@i18n/playguard/tools/update_via"/>
            <brls:Label id="pf_note" text="@i18n/playguard/prefs/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
