<?xml version="1.0" encoding="UTF-8"?>

<!-- Preferences: only what sets PlayGuard itself up — the app (language,
     theme, text size and start tab as tiles first, the palette, the
     effects, the sidebar, the intro),
     the messages it shows (the kinds of notifications, the monthly "Support
     PlayGuard" reminder), how it updates and the first steps again. A
     setting that shapes one feature sits with it (extra time in Play timer,
     relocking in Security, the clock check in Console › Network clock); the
     change history and backups have their tab, Help & diagnostics is in
     About. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header title="@i18n/playguard/prefs/section_app" marginBottom="8"/>
            <aurore:DetailCell id="pf_language" title="@i18n/cadran/tools/language"/>
            <aurore:DetailCell id="pf_theme" title="@i18n/cadran/tools/theme"/>
            <aurore:DetailCell id="pf_text_size" title="@i18n/playguard/tiles/text_size"/>
            <aurore:DetailCell id="pf_start_tab" title="@i18n/playguard/tiles/start_tab"/>
            <aurore:DetailCell id="pf_palette" title="@i18n/cadran/tools/palette"/>
            <aurore:DetailCell id="pf_effects" title="@i18n/playguard/prefs/effects"/>
            <aurore:DetailCell id="pf_rail" title="@i18n/cadran/prefs/rail"/>
            <aurore:BooleanCell id="pf_intro"/>
            <aurore:Header title="@i18n/playguard/prefs/section_notices" marginTop="24" marginBottom="8"/>
            <aurore:BooleanCell id="pf_notices_system"/>
            <aurore:BooleanCell id="pf_notices_summary"/>
            <aurore:BooleanCell id="pf_notices_reminders"/>
            <aurore:BooleanCell id="pf_notices_ack_remind"/>
            <aurore:BooleanCell id="pf_support_reminder"/>
            <aurore:Header title="@i18n/playguard/tools/section_update" marginTop="24" marginBottom="8"/>
            <aurore:BooleanCell id="pf_update_daily"/>
            <aurore:DetailCell id="pf_update_via" title="@i18n/playguard/tools/update_via"/>
            <aurore:Header title="@i18n/playguard/tools/section_start" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="pf_first_steps" title="@i18n/playguard/onboarding/open"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
