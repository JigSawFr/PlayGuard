<?xml version="1.0" encoding="UTF-8"?>

<!-- Preferences: only what sets PlayGuard itself up — the app (language,
     theme, start tab, the intro) and the messages it shows (the kinds of
     notifications, the monthly "Support PlayGuard" reminder). A setting
     that shapes one feature sits with it (extra time in Play timer,
     relocking in PIN, the clock check in Console › Network clock); the
     updates and Help & diagnostics are in About. -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header title="@i18n/playguard/prefs/section_app" marginBottom="8"/>
            <brls:DetailCell id="pf_language" title="@i18n/playguard/tools/language"/>
            <brls:DetailCell id="pf_theme" title="@i18n/playguard/tools/theme"/>
            <brls:DetailCell id="pf_text_size" title="@i18n/playguard/prefs/text_size"/>
            <brls:DetailCell id="pf_start_tab" title="@i18n/playguard/tools/start_tab"/>
            <brls:DetailCell id="pf_effects" title="@i18n/playguard/prefs/effects"/>
            <brls:BooleanCell id="pf_intro"/>
            <brls:Header title="@i18n/playguard/prefs/section_notices" marginTop="24" marginBottom="8"/>
            <brls:BooleanCell id="pf_notices_system"/>
            <brls:BooleanCell id="pf_notices_summary"/>
            <brls:BooleanCell id="pf_notices_reminders"/>
            <brls:BooleanCell id="pf_notices_ack_remind"/>
            <brls:BooleanCell id="pf_support_reminder"/>
            <!-- What PlayGuard changed, and the settings backups (the History tab before). -->
            <brls:Header title="@i18n/playguard/tools/section_history" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="hs_history" title="@i18n/playguard/history/open"/>
            <brls:Header title="@i18n/playguard/tools/section_backup" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="hs_backup_save" title="@i18n/playguard/tools/backup_save"/>
            <brls:DetailCell id="hs_backup_restore" title="@i18n/playguard/tools/backup_restore"/>
            <brls:DetailCell id="hs_backup_keep" title="@i18n/playguard/tools/backup_keep"/>
            <brls:Label id="hs_backup_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
