<?xml version="1.0" encoding="UTF-8"?>

<!-- Optional modules › one module: what it does, its state, Install / Update,
     At boot, Start / Stop now (the agent only), Remove. The title and the
     text are the module's, set by source/activity/modules_activity.cpp. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header id="md_header" title=" " marginBottom="8"/>
            <aurore:Label id="md_about" text=" " fontSize="20" marginBottom="10" textColor="@theme/cadran/text3"/>
            <aurore:DetailCell id="md_status" title="@i18n/playguard/modules/status"/>
            <aurore:DetailCell id="md_action" title="@i18n/playguard/modules/install"/>
            <aurore:BooleanCell id="md_boot"/>
            <aurore:DetailCell id="md_run" title="@i18n/playguard/modules/start"/>
            <aurore:DetailCell id="md_remove" title="@i18n/playguard/modules/remove"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
