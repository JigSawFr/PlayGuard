<?xml version="1.0" encoding="UTF-8"?>

<!-- Optional modules › Overview: what the modules are, and a cell per module
     with its state (Ⓐ opens its tab). Filled by
     source/activity/modules_activity.cpp. -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Label id="md_intro" text="@i18n/playguard/modules/intro" fontSize="20" marginBottom="16" textColor="@theme/cadran/text3"/>
            <brls:Header title="@i18n/playguard/modules/section" marginBottom="8"/>
            <brls:DetailCell id="md_rescue" title="@i18n/playguard/modules/rescue/tab"/>
            <brls:DetailCell id="md_agent" title="@i18n/playguard/modules/agent/title"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
