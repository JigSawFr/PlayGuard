<?xml version="1.0" encoding="UTF-8"?>

<!-- Console: what it runs (firmware, Atmosphère, hekate, sys-patch: tiles, A on each
     opens its release notes), under Diagnostics the network clock (its own
     screen, the former tab) and the installed games check, under Homebrew
     the forwarders (homebrew on the HOME menu), then
     compatibility, storage, the serial number and the game patches. -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <!-- A on each: its release notes (activity/sys_notes_activity.hpp). -->
            <brls:Header title="@i18n/playguard/tools/section_system" marginBottom="8"/>
            <brls:DetailCell id="cn_fw" title="@i18n/playguard/tools/firmware"/>
            <brls:DetailCell id="cn_ams" title="@i18n/playguard/tools/atmosphere"/>
            <brls:DetailCell id="cn_hekate" title="hekate"/>
            <brls:DetailCell id="cn_syspatch" title="sys-patch"/>
            <brls:Header title="@i18n/playguard/tools/section_diag" marginBottom="8"/>
            <brls:DetailCell id="cn_clock" title="@i18n/playguard/tabs/clock"/>
            <brls:DetailCell id="cn_games" title="@i18n/playguard/games/open"/>
            <!-- Homebrew on the HOME menu (activity/forwarders_activity.hpp). -->
            <brls:Header title="@i18n/playguard/forwarders/section" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="cn_forwarders" title="@i18n/playguard/forwarders/open"/>
            <brls:Header title="@i18n/playguard/tools/section_console" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="cn_compat" title="@i18n/playguard/tools/compat"/>
            <brls:DetailCell id="cn_storage" focusable="false" title="@i18n/playguard/tools/storage"/>
            <brls:DetailCell id="cn_blank" focusable="false" title="@i18n/playguard/tools/blank"/>
            <brls:DetailCell id="cn_serial" title="@i18n/playguard/tools/serial"/>
            <brls:DetailCell id="cn_patches" title="@i18n/playguard/tools/patches"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
