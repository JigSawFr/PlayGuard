<?xml version="1.0" encoding="UTF-8"?>

<!-- The change history, newest first, one group per day: what is shown
     (everything, one kind of change, the refused ones), an export, then the
     changes. A on a change shows it and offers to put the previous value
     back. The list is built by source/activity/history_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/history/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            id="hi_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="hi_note" text="" fontSize="20" marginBottom="16" textColor="@theme/cadran/text3"/>
            <aurore:DetailCell id="hi_filter" title="@i18n/playguard/history/show"/>
            <aurore:DetailCell id="hi_export" title="@i18n/playguard/history/export"/>
            <aurore:DetailCell id="hi_week" title="@i18n/playguard/forwarders/week_cell"/>
            <aurore:Box id="hi_list" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="16"/>
            <aurore:Label id="hi_empty" text="@i18n/playguard/history/none" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
