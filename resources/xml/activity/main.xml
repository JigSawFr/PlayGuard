<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen: a rail of tabs (cadran::style_rail gives it its icons), each
     tab a custom view registered in main.cpp and implemented in source/tab/. -->

<brls:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <brls:TabFrame
        id="main_tabs"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg">

        <brls:Tab label="@i18n/playguard/cadran/tabs/today">
            <CadranTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/play_timer">
            <CadranPlayTimerTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/activity">
            <CadranActivityTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/restrictions">
            <CadranRestrictionsTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/security">
            <CadranSecurityTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/console">
            <CadranConsoleTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/history">
            <CadranHistoryTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/preferences">
            <CadranPreferencesTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/about">
            <CadranAboutTab/>
        </brls:Tab>

    </brls:TabFrame>

</brls:AppletFrame>
