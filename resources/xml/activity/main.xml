<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen: a rail of tabs (cadran::style_rail gives it its icons), each
     tab a custom view registered in main.cpp and implemented in source/tab/. -->

<aurore:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <aurore:TabFrame
        id="main_tabs"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg">

        <aurore:Tab label="@i18n/playguard/tabs/dashboard">
            <DashboardTab/>
        </aurore:Tab>

        <aurore:Separator/>

        <aurore:Tab label="@i18n/playguard/tabs/play_timer">
            <PlayTimerTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playguard/tabs/activity">
            <ActivityTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playguard/tabs/restrictions">
            <RestrictionsTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playguard/tabs/security">
            <SecurityTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playguard/tabs/history">
            <HistoryTab/>
        </aurore:Tab>

        <aurore:Separator/>

        <aurore:Tab label="@i18n/playguard/tabs/console">
            <ConsoleTab/>
        </aurore:Tab>

        <aurore:Separator/>

        <aurore:Tab label="@i18n/playguard/tabs/preferences">
            <PreferencesTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playguard/tabs/about">
            <AboutTab/>
        </aurore:Tab>

    </aurore:TabFrame>

</aurore:AppletFrame>
