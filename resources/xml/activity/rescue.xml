<?xml version="1.0" encoding="UTF-8"?>

<!-- Recovery screen, shown at start-up when the playguard-rescue sysmodule
     left a report (a parent used the RESCUE file after forgetting the PIN).
     It says what happened, then offers to set a new PIN or delete
     every parental control, before continuing to PlayGuard. Filled by
     rescue_activity.cpp; it bypasses PlayGuard's own "ask the PIN to open". -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/rescue/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="rc_outcome" text="" fontSize="26" marginBottom="6"/>
            <aurore:Label id="rc_note" text="" fontSize="20" marginBottom="20" textColor="@theme/cadran/text3"/>

            <aurore:Header id="rc_actions_header" title="@i18n/playguard/rescue/section_actions" marginBottom="8"/>
            <aurore:DetailCell id="rc_reset_pin" title="@i18n/playguard/rescue/reset_pin"/>
            <aurore:DetailCell id="rc_delete" title="@i18n/playguard/security/delete"/>

            <aurore:Header title="@i18n/playguard/rescue/section_done" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="rc_continue" title="@i18n/playguard/rescue/continue"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
