<?xml version="1.0" encoding="UTF-8"?>

<!-- Activity › Games: every game played over the chosen period, as a list or
     a grid of covers (Y switches, X picks the period), under the selected
     game's figures, which stay on top. The cells and the covers are added by
     source/activity/games_activity.cpp; A on one opens its screen
     (activity/game.xml). -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:Box
        title="@i18n/playguard/library/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <!-- The selected game: its icon, name and figures. -->
        <brls:Box
            id="gs_head"
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            paddingTop="20"
            paddingBottom="16"
            paddingLeft="60"
            paddingRight="60"
            lineBottom="1"
            lineColor="@theme/brls/header/border">

            <brls:Image id="gs_icon" width="96" height="96" cornerRadius="12" marginRight="24" backgroundColor="@theme/cadran/well"/>
            <brls:Box axis="column" alignItems="stretch" grow="1.0">
                <brls:Label id="gs_name" text=" " fontSize="26" singleLine="true"/>
                <brls:Box axis="row" alignItems="flexStart" marginTop="10">
                    <brls:Box axis="column" width="220" marginRight="16">
                        <brls:Label id="gs_period_caption" text=" " fontSize="16" singleLine="true" textColor="@theme/cadran/text3"/>
                        <brls:Label id="gs_period" text="—" fontSize="22" marginTop="4" singleLine="true"/>
                    </brls:Box>
                    <brls:Box axis="column" width="220" marginRight="16">
                        <brls:Label text="@i18n/playguard/activity/all_time" fontSize="16" singleLine="true" textColor="@theme/cadran/text3"/>
                        <brls:Label id="gs_total" text="—" fontSize="22" marginTop="4" singleLine="true"/>
                    </brls:Box>
                    <brls:Box axis="column" width="140" marginRight="16">
                        <brls:Label text="@i18n/playguard/activity/launches" fontSize="16" singleLine="true" textColor="@theme/cadran/text3"/>
                        <brls:Label id="gs_launches" text="—" fontSize="22" marginTop="4" singleLine="true"/>
                    </brls:Box>
                    <brls:Box axis="column" grow="1.0">
                        <brls:Label text="@i18n/playguard/activity/last" fontSize="16" singleLine="true" textColor="@theme/cadran/text3"/>
                        <brls:Label id="gs_last" text="—" fontSize="22" marginTop="4" singleLine="true"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>
        </brls:Box>

        <ScrollView
            id="gs_scroll"
            width="auto"
            height="auto"
            grow="1.0">

            <brls:Box
                id="gs_content"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                paddingLeft="60"
                paddingRight="60"
                paddingTop="16"
                paddingBottom="@style/brls/sidebar/padding_bottom">

                <brls:Box axis="row" alignItems="stretch" marginBottom="8">
                    <brls:DetailCell id="gs_view" title="@i18n/playguard/library/view" grow="1.0" marginRight="16"/>
                    <brls:DetailCell id="gs_period_cell" title="@i18n/playguard/activity/period" grow="1.0"/>
                </brls:Box>
                <brls:Box id="gs_progress" axis="row" alignItems="center" marginTop="10" marginBottom="6" marginLeft="16" marginRight="16">
                    <brls:ProgressSpinner width="30" height="30" marginRight="14"/>
                    <brls:Label text="@i18n/playguard/activity/loading" fontSize="20" grow="1.0" textColor="@theme/cadran/text3"/>
                </brls:Box>
                <brls:Box id="gs_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
                <brls:Label id="gs_capped" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3" visibility="gone"/>
                <brls:Label id="gs_status" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3" visibility="gone"/>

            </brls:Box>

        </ScrollView>

    </brls:Box>

</brls:AppletFrame>
