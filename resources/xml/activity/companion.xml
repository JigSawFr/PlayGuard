<?xml version="1.0" encoding="UTF-8"?>

<!-- Security › the companion phone app: linked or not, last sync, the block
     comparison, unlink.
     Filled by source/activity/companion_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/pairing/section"
        icon="@res/img/app_icon.png"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:DetailCell id="pr_active" focusable="false" title="@i18n/playguard/pairing/active"/>
            <aurore:DetailCell id="pr_updated" focusable="false" title="@i18n/playguard/pairing/updated"/>
            <aurore:DetailCell id="pr_decode" title="@i18n/playguard/pairing/decode"/>
            <aurore:DetailCell id="pr_unlink" title="@i18n/playguard/pairing/unlink"/>
            <aurore:Label id="pr_note" text="@i18n/playguard/pairing/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
