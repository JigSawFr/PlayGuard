<?xml version="1.0" encoding="UTF-8"?>

<!-- A newer release of PlayGuard's Home Assistant integration: the version
     Home Assistant runs, the QR code that opens the integration in HACS on a
     phone, and what changed since. Opened from the notification bell and
     Remote access › Home Assistant; filled by ha_update_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Header id="hu_header" marginBottom="8"/>
            <aurore:Box width="auto" height="auto" axis="row" alignItems="center">
                <aurore:Label id="hu_body" text="" fontSize="20" grow="1.0" shrink="1.0" marginRight="24"/>
                <aurore:Box id="hu_qr" width="auto" height="auto" shrink="0.0"/>
            </aurore:Box>
            <aurore:Header id="hu_changes" marginTop="16" marginBottom="8"/>
            <aurore:Box id="hu_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="hu_note" text="" fontSize="20" marginTop="16" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
