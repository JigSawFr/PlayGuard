<?xml version="1.0" encoding="UTF-8"?>

<!-- First steps: three steps with their state, each one done right here (the
     system PIN screen, the daily-limit picker, the guided clock measure), a
     fourth while the phone app is linked (unlink it), one more while the
     "time's up" alarm is off (turn it back on), one once a PIN is set (Protect
     PlayGuard with the PIN, the PIN tab's choice), and whether the screen opens
     by itself at start-up; below Close, Support PlayGuard (the funding QR
     codes). Under the note, on emuMMC (or on sysMMC with an emuMMC set up),
     that the other system has its own parental controls.
     Shown at start-up while no PIN is set; the bell's "no PIN" entry and
     About › Help & diagnostics › First steps bring it back. Filled by onboarding_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/onboarding/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="ob_headline" text="" fontSize="24" marginBottom="16"/>
            <aurore:Header title="@i18n/playguard/onboarding/section_steps" marginBottom="8"/>
            <aurore:DetailCell id="ob_pin" title="@i18n/playguard/onboarding/step_pin"/>
            <aurore:DetailCell id="ob_limit" title="@i18n/playguard/onboarding/step_limit"/>
            <aurore:DetailCell id="ob_clock" title="@i18n/playguard/onboarding/step_clock"/>
            <aurore:DetailCell id="ob_unlink" title="@i18n/playguard/onboarding/step_unlink"/>
            <aurore:DetailCell id="ob_alarm"/>
            <aurore:DetailCell id="ob_protect"/>
            <aurore:Label id="ob_note" text="@i18n/playguard/onboarding/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Label id="ob_storage_note" text="" fontSize="20" marginTop="4" marginBottom="6" textColor="@theme/cadran/amber"/>
            <aurore:BooleanCell id="ob_at_start" marginTop="16"/>
            <aurore:DetailCell id="ob_close" title="@i18n/playguard/onboarding/close"/>
            <aurore:DetailCell id="ob_support" title="@i18n/playguard/about/section_support" marginTop="24"/>
            <MadeInFrance marginTop="24"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
