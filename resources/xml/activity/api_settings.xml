<?xml version="1.0" encoding="UTF-8"?>

<!-- Preferences › Other homebrews: the switch, one permission per group of
     routes (added by the code: the groups this build answers), the last
     calls, and "Turn it all off". Filled by
     source/activity/api_settings_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/api/settings_title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:BooleanCell id="as_enabled"/>
            <brls:Label id="as_note" text="@i18n/playguard/api/settings_note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <brls:Header title="@i18n/playguard/api/section_permissions" marginTop="24" marginBottom="8"/>
            <brls:Box id="as_perms" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:DetailCell id="as_all_off" title="@i18n/playguard/api/all_off" marginTop="8"/>
            <brls:Header title="@i18n/playguard/api/section_calls" marginTop="24" marginBottom="8"/>
            <brls:Box id="as_calls" width="auto" height="auto" axis="column" alignItems="stretch"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
