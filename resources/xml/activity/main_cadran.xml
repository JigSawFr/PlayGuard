<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen with the "Cadran" prototype Overview (desktop simulation, PLAYGUARD_SIM_CADRAN=1):
     the tabs carry the boards' short French labels; cadran::style_frame adds the icons. Each tab
     is a custom view registered in main.cpp and implemented in source/tab/. -->

<brls:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <brls:TabFrame
        id="main_tabs"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg">

        <brls:Tab label="Aujourd'hui">
            <CadranTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="Temps de jeu">
            <CadranPlayTimerTab/>
        </brls:Tab>

        <brls:Tab label="Activité">
            <CadranActivityTab/>
        </brls:Tab>

        <brls:Tab label="Restrictions">
            <CadranRestrictionsTab/>
        </brls:Tab>

        <brls:Tab label="Horloge">
            <ClockTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="Sécurité">
            <SecurityTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="Préférences">
            <PreferencesTab/>
        </brls:Tab>

        <brls:Tab label="Outils">
            <ToolsTab/>
        </brls:Tab>

        <brls:Tab label="À propos">
            <AboutTab/>
        </brls:Tab>

    </brls:TabFrame>

</brls:AppletFrame>
