<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen in the Cadran appearance (cadran::enabled(), Preferences ›
     Appearance): the tabs of main.xml in the same order, each the tab itself
     with its Cadran top (source/tab/cadran_*.cpp, registered in main.cpp);
     cadran::style_rail gives the sidebar its icons. -->

<brls:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <brls:TabFrame
        id="main_tabs"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg">

        <brls:Tab label="@i18n/playguard/cadran/tabs/today">
            <CadranTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/play_timer">
            <CadranPlayTimerTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/activity">
            <CadranActivityTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/restrictions">
            <CadranRestrictionsTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/security">
            <CadranSecurityTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/console">
            <ConsoleTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/history">
            <HistoryTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/preferences">
            <CadranPreferencesTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/about">
            <CadranAboutTab/>
        </brls:Tab>

    </brls:TabFrame>

</brls:AppletFrame>
