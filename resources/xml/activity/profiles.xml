<?xml version="1.0" encoding="UTF-8"?>

<!-- Saved play-time profiles: A on one offers apply / edit / rename / delete;
     below, save the current limits or make a new profile. The
     list is rebuilt by source/activity/profiles_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/play_timer/profiles_title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Header title="@i18n/playguard/play_timer/profiles_section_saved" marginBottom="8"/>
            <aurore:Box id="pf_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="pf_empty" text="@i18n/playguard/play_timer/profile_none" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Label id="pf_hint" text="@i18n/playguard/play_timer/profiles_hint" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Header title="@i18n/playguard/play_timer/profiles_section_new" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="pf_save" title="@i18n/playguard/play_timer/profile_save"/>
            <aurore:DetailCell id="pf_new" title="@i18n/playguard/play_timer/profile_new"/>
            <aurore:DetailCell id="pf_schedule" title="@i18n/playguard/schedule/cell"/>
            <aurore:Label id="pf_schedule_note" text="@i18n/playguard/schedule/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
