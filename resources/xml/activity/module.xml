<?xml version="1.0" encoding="UTF-8"?>

<!-- Optional modules › one module: what it does, its state, Install / Update,
     At boot, Remove. The text is the module's, set by
     source/activity/modules_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/modules/rescue/short_title"
        icon="@res/img/app_icon.png"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="md_about" text=" " fontSize="20" marginBottom="16" textColor="@theme/cadran/text3"/>
            <aurore:DetailCell id="md_status" title="@i18n/playguard/modules/status"/>
            <aurore:DetailCell id="md_action" title="@i18n/playguard/modules/install"/>
            <aurore:BooleanCell id="md_boot"/>
            <aurore:DetailCell id="md_remove" title="@i18n/playguard/modules/remove"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
