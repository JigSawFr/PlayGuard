<?xml version="1.0" encoding="UTF-8"?>

<!-- One game of the Activity tab: its icon and name, its last seven days as
     bars, the figures and the play time of each user account. Read-only (B
     goes back; nothing to focus, the D-pad scrolls). Filled by
     source/activity/game_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/tabs/activity"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Box axis="row" alignItems="center" marginBottom="16">
                <aurore:Image id="ga_icon" width="72" height="72" cornerRadius="@style/cadran/radius/icon" marginRight="20"/>
                <aurore:Label id="ga_name" text="" fontSize="28" grow="1.0"/>
            </aurore:Box>
            <aurore:Header title="@i18n/playguard/activity/week" marginBottom="8"/>
            <PlayDaysView id="ga_days" width="auto" height="auto" marginTop="8" marginBottom="16"/>
            <aurore:Header title="@i18n/playguard/activity/section_game_time" marginTop="8" marginBottom="8"/>
            <aurore:DetailCell id="ga_today" focusable="false" title="@i18n/playguard/activity/today"/>
            <aurore:DetailCell id="ga_week" focusable="false" title="@i18n/playguard/activity/week"/>
            <aurore:DetailCell id="ga_total" focusable="false" title="@i18n/playguard/activity/all_time"/>
            <aurore:DetailCell id="ga_launches" focusable="false" title="@i18n/playguard/activity/launches"/>
            <aurore:DetailCell id="ga_first" focusable="false" title="@i18n/playguard/activity/first"/>
            <aurore:DetailCell id="ga_last" focusable="false" title="@i18n/playguard/activity/last"/>
            <aurore:DetailCell id="ga_rating" focusable="false" title="@i18n/playguard/activity/rating"/>
            <aurore:Header id="ga_accounts_header" title="@i18n/playguard/activity/section_accounts" marginTop="24" marginBottom="8"/>
            <aurore:Box id="ga_accounts" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="ga_accounts_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
