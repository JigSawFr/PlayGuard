<?xml version="1.0" encoding="UTF-8"?>

<!-- The Cadran child screen (Overview › Show the child): the time left today
     as one big ring, the bedtime, nothing to change. Filled by
     source/activity/cadran_child_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:Box
        id="child_root"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg"
        focusable="true"
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        grow="1.0">

        <brls:Label text="@i18n/playguard/cadran/child/title" fontSize="30" textColor="@theme/cadran/text2" marginBottom="22"/>
        <PtRing id="child_ring" width="340" height="340" marginBottom="22"/>
        <brls:Box axis="row" alignItems="center" marginBottom="18">
            <brls:Box id="child_bed_chip" axis="row" alignItems="center" height="48" paddingLeft="20" paddingRight="20" cornerRadius="24" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1" marginRight="12">
                <CadranIcon icon="moon" width="20" height="20" color="@theme/cadran/amber" marginRight="10"/>
                <brls:Label text="@i18n/playguard/cadran/child/bed" fontSize="18" marginRight="8"/>
                <CadranDigits id="child_bedtime" text="21:00" fontSize="18" textColor="@theme/cadran/amber"/>
            </brls:Box>
            <brls:Box axis="row" alignItems="center" height="48" paddingLeft="20" paddingRight="20" cornerRadius="24" backgroundColor="@theme/cadran/surf" borderColor="@theme/cadran/line" borderThickness="1">
                <brls:Label id="child_time_up" text="" fontSize="18" textColor="@theme/cadran/text2"/>
            </brls:Box>
        </brls:Box>
        <brls:Label text="@i18n/playguard/cadran/child/enjoy" fontSize="16" textColor="@theme/cadran/text3"/>

    </brls:Box>

</brls:AppletFrame>
