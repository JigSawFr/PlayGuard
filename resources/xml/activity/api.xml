<?xml version="1.0" encoding="UTF-8"?>

<!-- A request from another homebrew (docs/api.md): who asks, one row per
     request with how it went, then where PlayGuard goes next. Filled by
     source/activity/api_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:Box
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        justifyContent="center"
        alignItems="center"
        grow="1.0"
        paddingLeft="60"
        paddingRight="60">

        <brls:Label
            text="@i18n/playguard/api/screen_title"
            fontSize="28"
            horizontalAlign="center"
            marginBottom="12"/>

        <brls:Label
            id="api_from"
            horizontalAlign="center"
            marginBottom="28"
            textColor="@theme/cadran/text3"/>

        <brls:Box
            id="api_rows"
            width="760"
            height="auto"
            axis="column"
            alignItems="stretch"/>

        <brls:Label
            id="api_next"
            horizontalAlign="center"
            marginTop="28"
            textColor="@theme/cadran/text3"/>

    </brls:Box>

</brls:AppletFrame>
