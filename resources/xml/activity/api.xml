<?xml version="1.0" encoding="UTF-8"?>

<!-- A request from another homebrew (docs/api.md): who asks, one row per
     request (its name, its route small, how it went), then where PlayGuard
     goes next, Continue and, for a request the parent has not allowed,
     Allow…. Filled by source/activity/api_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:Box
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        justifyContent="center"
        alignItems="center"
        grow="1.0"
        paddingLeft="60"
        paddingRight="60">

        <brls:Label
            text="@i18n/playguard/api/screen_title"
            width="760"
            fontSize="28"
            horizontalAlign="center"
            marginBottom="12"/>

        <brls:Label
            id="api_from"
            width="760"
            horizontalAlign="center"
            marginBottom="28"
            textColor="@theme/cadran/text3"/>

        <brls:Box
            id="api_rows"
            width="760"
            height="auto"
            axis="column"
            alignItems="stretch"/>

        <brls:Label
            id="api_next"
            width="760"
            horizontalAlign="center"
            marginTop="24"
            marginBottom="20"
            textColor="@theme/cadran/text3"/>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            justifyContent="center">

            <brls:Button
                id="api_continue"
                style="primary"
                width="300"
                visibility="gone"
                text="@i18n/playguard/api/continue"/>

            <brls:Button
                id="api_allow"
                style="bordered"
                width="300"
                marginLeft="20"
                visibility="gone"
                text="@i18n/playguard/api/allow"/>

        </brls:Box>

    </brls:Box>

</brls:AppletFrame>
