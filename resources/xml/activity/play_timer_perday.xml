<?xml version="1.0" encoding="UTF-8"?>

<!-- Per-day play-time limits: the week chart is the editor (←/→ pick a day,
     A changes it); edits are staged in `pending[]` and written together by
     "Save" (also +). B leaves (asking first when something is unsaved). -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/play_timer/perday/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <PtStateHeader id="pt_state_header"/>

            <aurore:Header title="@i18n/playguard/play_timer/week_title" marginBottom="8"/>

            <!-- The week and its keys: view/cadran_week_card.xml, added here. -->
            <aurore:Box id="pt_week_card" axis="column" alignItems="stretch"/>
            <aurore:Label id="pt_unavailable" text="@i18n/playguard/play_timer/perday/unavailable" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/amber"/>

            <aurore:Header title="@i18n/playguard/play_timer/perday/section_presets" marginTop="16" marginBottom="8"/>

            <aurore:DetailCell id="pt_weekdays" title="@i18n/playguard/tiles/weekdays"/>
            <aurore:DetailCell id="pt_weekend"  title="@i18n/playguard/tiles/weekend"/>
            <aurore:DetailCell id="pt_copy_today"/>
            <aurore:DetailCell id="pt_revert"   title="@i18n/playguard/play_timer/perday/revert"/>

            <aurore:Header title="@i18n/playguard/play_timer/perday/section_save" marginTop="16" marginBottom="8"/>

            <aurore:DetailCell id="pt_save" title="@i18n/playguard/play_timer/perday/save"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
