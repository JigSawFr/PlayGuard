<?xml version="1.0" encoding="UTF-8"?>

<!-- Shown when the pctl service cannot be opened (typically: no CFW). B exits. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <aurore:Box
        title="@i18n/playguard/init_error/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        justifyContent="center"
        alignItems="center"
        grow="1.0"
        paddingLeft="60"
        paddingRight="60">

        <aurore:Label
            text="@i18n/playguard/init_error/headline"
            fontSize="28"
            horizontalAlign="center"
            marginBottom="20"/>

        <aurore:Label
            id="error_code"
            text="—"
            fontSize="20"
            horizontalAlign="center"
            marginBottom="12"
            textColor="@theme/cadran/text3"/>

        <aurore:Label
            id="error_fw"
            text=""
            fontSize="20"
            horizontalAlign="center"
            marginBottom="32"
            textColor="@theme/cadran/text3"/>

        <aurore:Label
            text="@i18n/playguard/init_error/body"
            horizontalAlign="center"/>

    </aurore:Box>

</aurore:AppletFrame>
