<?xml version="1.0" encoding="UTF-8"?>

<!-- Developer tools › Install another build: a bar while the list is
     fetched, a tab each for the last releases, main's last commits and the
     open pull requests (L / R move from one to the next, A on the pull
     requests' tab sorts them, Y finds a build), the builds of the chosen one,
     then signing in, going back to the previous build,
     and how old the list is (X fetches
     it again). The lists are built
     by source/activity/dev_builds_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/dev_build/open"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="db_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="db_note" text="" fontSize="20" marginBottom="16" textColor="@theme/brand/note"/>
            <!-- While the list is fetched (or a build looked for): a bar and the step. -->
            <brls:Box id="db_loading" width="auto" height="auto" axis="column" alignItems="center"
                marginTop="8" marginBottom="24" visibility="gone">
                <LoadingBar id="db_loading_bar" width="420" height="8" marginBottom="14"/>
                <brls:Label id="db_loading_text" text=" " fontSize="18" horizontalAlign="center"
                    textColor="@theme/brand/note"/>
            </brls:Box>
            <!-- Between the L and R icons (set in the code): the footer has no
                 room for their hint next to Y's, X's, B's and A's on the console. -->
            <brls:Box id="db_tabs" width="auto" height="auto" axis="row" alignItems="center" marginBottom="16">
                <brls:Label id="db_tab_l" text=" " fontSize="25.5" marginRight="12" textColor="@theme/brand/note"/>
                <brls:Button id="db_tab_release" style="default" text=" " marginRight="12"/>
                <brls:Button id="db_tab_main" style="default" text=" " marginRight="12"/>
                <brls:Button id="db_tab_pulls" style="default" text=" " marginRight="12"/>
                <brls:Label id="db_tab_r" text=" " fontSize="25.5" textColor="@theme/brand/note"/>
            </brls:Box>
            <brls:Box id="db_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:DetailCell id="db_sign_in" title="@i18n/playguard/dev_build/sign_in" marginTop="24"/>
            <brls:DetailCell id="db_back" title=" " marginTop="24"/>
            <brls:Label id="db_checked" text=" " fontSize="18" marginTop="16" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
