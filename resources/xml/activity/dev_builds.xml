<?xml version="1.0" encoding="UTF-8"?>

<!-- Developer tools › Install another build: the latest release, main's last
     commits and the open pull requests under their headers (Y sorts the pull
     requests), then signing in and refreshing the list. The lists are built
     by source/activity/dev_builds_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/dev_build/open"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="db_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="db_note" text="" fontSize="20" marginBottom="16" textColor="@theme/brand/note"/>
            <brls:Header id="db_release_header" title=" " marginBottom="8"/>
            <brls:Box id="db_release" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Header id="db_main_header" title=" " marginTop="24" marginBottom="8"/>
            <brls:Box id="db_main" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Header id="db_pulls_header" title=" " marginTop="24" marginBottom="8"/>
            <brls:Box id="db_pulls" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Box width="auto" height="auto" axis="column" alignItems="stretch" marginTop="24">
                <brls:DetailCell id="db_sign_in" title="@i18n/playguard/dev_build/sign_in"/>
                <brls:DetailCell id="db_refresh" title=" "/>
            </brls:Box>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
