<?xml version="1.0" encoding="UTF-8"?>

<!-- Developer tools › Install another build: a tab each for the latest
     release, main's last commits and the open pull requests (L / R move from
     one to the next, Y sorts the pull requests), the builds of the chosen one,
     then signing in, and how old the list is (X fetches it again). The lists are built
     by source/activity/dev_builds_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/dev_build/open"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="db_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="db_note" text="" fontSize="20" marginBottom="16" textColor="@theme/brand/note"/>
            <brls:Box id="db_tabs" width="auto" height="auto" axis="row" marginBottom="16">
                <brls:Button id="db_tab_release" style="default" text=" " marginRight="12"/>
                <brls:Button id="db_tab_main" style="default" text=" " marginRight="12"/>
                <brls:Button id="db_tab_pulls" style="default" text=" "/>
            </brls:Box>
            <brls:Box id="db_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:DetailCell id="db_sign_in" title="@i18n/playguard/dev_build/sign_in" marginTop="24"/>
            <brls:Label id="db_checked" text=" " fontSize="18" marginTop="16" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
