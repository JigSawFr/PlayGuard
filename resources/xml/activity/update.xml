<?xml version="1.0" encoding="UTF-8"?>

<!-- A newer PlayGuard: at start-up (action/update_flow) or after Check for
     updates. Update, the way it is installed, Later, then the new version's
     notes. Filled by update_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/update/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="up_headline" text="" fontSize="26" marginBottom="12"/>
            <brls:Label id="up_body" text="" fontSize="20" marginBottom="16" textColor="@theme/brand/note"/>
            <brls:DetailCell id="up_update"/>
            <brls:DetailCell id="up_method" title="@i18n/playguard/tools/update_via"/>
            <brls:DetailCell id="up_later" title="@i18n/playguard/common/later"/>
            <brls:Header id="up_notes_header" marginTop="32" marginBottom="8"/>
            <brls:Box id="up_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Label id="up_notes_none" text="" fontSize="20" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
