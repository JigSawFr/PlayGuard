<?xml version="1.0" encoding="UTF-8"?>

<!-- Console › Check the installed games: the games the HOME menu cannot start
     or draw, in a section per way out (repaired here, reinstalled, the
     firmware or SD card), A on one for the cause, the fix and the offer to
     remove it. The sections are built by
     source/activity/game_check_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/games/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="gc_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="gc_note" text="@i18n/playguard/games/note" fontSize="20" marginBottom="16" textColor="@theme/cadran/text3"/>
            <brls:Label id="gc_status" text="@i18n/playguard/games/searching" fontSize="20" marginTop="10" marginBottom="6"/>
            <brls:Box id="gc_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Label id="gc_hint" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/amber"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
