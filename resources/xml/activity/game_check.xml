<?xml version="1.0" encoding="UTF-8"?>

<!-- Console › Check the installed games: the games the HOME menu cannot start
     or draw, in a section per way out (repaired here, reinstalled, the
     firmware or SD card), A on one for the cause, the fix and the offer to
     remove it. Above them, one short line: the note and the status small,
     the note only while no game is listed; with none, a card in their place
     (how many look fine, when they were checked, Check again). The sections
     and the card are built by source/activity/game_check_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/games/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            id="gc_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="gc_note" text="@i18n/playguard/games/note" fontSize="16" marginBottom="8" textColor="@theme/cadran/text3"/>
            <aurore:Label id="gc_status" text="@i18n/playguard/games/searching" fontSize="16" marginBottom="6"/>
            <aurore:Box id="gc_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="gc_hint" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/amber"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
