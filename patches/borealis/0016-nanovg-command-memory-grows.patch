+
+    /* PlayGuard: deko3d calls this when the command buffer is full. Without it, a frame of more
+       calls than DynamicCmdSize holds aborted the app (a long changelog). Another chunk is
+       given, one kept from an earlier frame when it is large enough: the frame's fence was
+       waited for in Flush(), so the GPU is done with it. */
+    void DkRenderer::AddCmdMemory(void *user_data, DkCmdBuf cmdbuf, size_t min_size) {
+        DkRenderer *self = static_cast<DkRenderer *>(user_data);
+        while (self->m_extra_cmd_used < self->m_extra_cmd_mem.size()) {
+            CMemPool::Handle &mem = self->m_extra_cmd_mem[self->m_extra_cmd_used++];
+            if (mem.getSize() >= min_size) {
+                dkCmdBufAddMemory(cmdbuf, mem.getMemBlock(), mem.getOffset(), mem.getSize());
+                return;
+            }
+        }
+        const size_t size = std::max(min_size, DynamicCmdSize);
+        CMemPool::Handle mem = self->m_data_mem_pool.allocate(static_cast<uint32_t>(size), DK_CMDMEM_ALIGNMENT);
+        if (!mem) {
+            return;   /* deko3d raises its out-of-memory error, as before */
+        }
+        self->m_extra_cmd_mem.push_back(mem);
+        self->m_extra_cmd_used = self->m_extra_cmd_mem.size();
+        dkCmdBufAddMemory(cmdbuf, mem.getMemBlock(), mem.getOffset(), mem.getSize());
     }
 
