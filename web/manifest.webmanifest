{
  "name": "PlayGuard simulator",
  "short_name": "PlayGuard",
  "description": "PlayGuard running in the browser against a simulated console.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1424",
  "theme_color": "#111d31",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "shortcuts": [
    {
      "name": "Today's limit reached",
      "short_name": "Limit reached",
      "url": "./?restricted=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Parental controls unlocked",
      "short_name": "Unlocked",
      "url": "./?unlocked=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "First start, no PIN yet",
      "short_name": "No PIN yet",
      "url": "./?not_set_up=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "The guided tour",
      "short_name": "Tour",
      "url": "./?tour=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
